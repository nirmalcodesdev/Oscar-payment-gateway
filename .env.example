# Runtime
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=oscar-payment-gateway
API_HOST=0.0.0.0
API_PORT=3000
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB must be a replica set in every production-like environment.
MONGODB_URI=mongodb://localhost:27017/oscar_payment_gateway?replicaSet=rs0
MONGODB_REPLICA_SET=rs0
MONGODB_CONNECT_TIMEOUT_MS=10000

# Redis/BullMQ
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=10000
QUEUE_PREFIX=oscar

# Production secret sourcing. Never place a working credential in this file.
SECRETS_MANAGER_PROVIDER=development-only
SECRETS_MANAGER_REFERENCE=replace-with-secret-manager-reference

# Reserved for later phases; inert placeholders only.
INTERNAL_HMAC_CURRENT_VERSION=v1
INTERNAL_HMAC_CURRENT_SECRET=replace-through-secret-manager
INTERNAL_HMAC_PREVIOUS_VERSION=
INTERNAL_HMAC_PREVIOUS_SECRET=
ADMIN_JWT_CURRENT_KEY_ID=v1
ADMIN_JWT_CURRENT_SECRET=replace-through-secret-manager-32-bytes-minimum
ADMIN_JWT_PREVIOUS_KEY_ID=
ADMIN_JWT_PREVIOUS_SECRET=
MERCHANT_STEP_UP_SECRET=replace-through-secret-manager-32-bytes-minimum
ADMIN_ACCESS_TTL_SEC=600
ADMIN_REFRESH_TTL_SEC=604800
MERCHANT_STEP_UP_TTL_SEC=300
WALLET_NETWORK_ALLOWLIST={"ethereum-mainnet":"mainnet","ethereum-sepolia":"testnet"}
RPC_PROVIDER_CATALOG={"primary":{"operatorId":"provider-company-a","url":"https://rpc-a.example/v1/replace-through-secret-manager"},"secondary":{"operatorId":"provider-company-b","url":"https://rpc-b.example/v1/replace-through-secret-manager"}}
RPC_REQUEST_TIMEOUT_MS=5000
WEBHOOK_SIGNING_KEY_VERSION=v1
WEBHOOK_SIGNING_SECRET=replace-through-secret-manager
SANCTIONS_PROVIDER=static-ofac
SANCTIONS_PROVIDER_API_KEY=replace-through-secret-manager
CORS_ALLOWED_ORIGINS=https://merchant.example,https://admin.example
PAYMENT_EXPIRY_MIN_SEC=300
PAYMENT_EXPIRY_MAX_SEC=7200
LATE_PAYMENT_GRACE_SEC=900
PAYMENT_CREATE_RATE_LIMIT_PER_MINUTE=30
ADMIN_RATE_LIMIT_PER_MINUTE=20

# At least two independently operated RPC providers are required per chain.
EVM_RPC_PRIMARY_URL=https://primary-provider.invalid
EVM_RPC_SECONDARY_URL=https://secondary-provider.invalid
EVM_REQUIRED_CONFIRMATIONS=12
