# Runtime
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=oscar-payment-gateway
API_HOST=0.0.0.0
API_PORT=3000
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB must be a replica set in every production-like environment;
# multi-document transactions fail silently against a standalone mongod.
MONGODB_URI=mongodb://user:replace-through-secret-manager@mongodb:27017/oscar_payment_gateway?replicaSet=rs0&authSource=admin
MONGODB_REPLICA_SET=rs0
MONGODB_CONNECT_TIMEOUT_MS=10000

# Redis/BullMQ (delivery coordination only; MongoDB is the correctness
# boundary). Use a durable Redis (AOF everysec or better) in production.
REDIS_URL=redis://replace-through-secret-manager@redis:6379
REDIS_CONNECT_TIMEOUT_MS=10000
QUEUE_PREFIX=oscar

# Production secret sourcing. Never place a working credential in this file.
# All *_SECRET values below are inert placeholders; source real values from
# the secrets manager referenced here (see docs/runbooks/secret-rotation.md).
SECRETS_MANAGER_PROVIDER=development-only
SECRETS_MANAGER_REFERENCE=replace-with-secret-manager-reference

# Admin JWT (versioned current/previous pair for zero-downtime rotation;
# see docs/runbooks/secret-rotation.md).
ADMIN_JWT_CURRENT_KEY_ID=v1
ADMIN_JWT_CURRENT_SECRET=replace-through-secret-manager-32-bytes-minimum
ADMIN_JWT_PREVIOUS_KEY_ID=
ADMIN_JWT_PREVIOUS_SECRET=
MERCHANT_STEP_UP_SECRET=replace-through-secret-manager-32-bytes-minimum
ADMIN_ACCESS_TTL_SEC=600
ADMIN_REFRESH_TTL_SEC=604800
MERCHANT_STEP_UP_TTL_SEC=300

# Chain registry: at least two independently operated RPC providers per
# chain, selected by provider id from this operator-owned catalog. URLs are
# never accepted from clients, never stored in the database, and never
# appear in API responses or audit entries. A chain's native gas coin is not
# an env constant: register it as a native token on the chain via the admin
# API (`POST /api/v1/admin/tokens` with `assetType` omitted defaults to
# erc20; `"native"` snapshots the chain's `nativeCurrency`).
RPC_PROVIDER_CATALOG={"primary":{"operatorId":"provider-company-a","url":"https://rpc-a.example/v1/replace-through-secret-manager"},"secondary":{"operatorId":"provider-company-b","url":"https://rpc-b.example/v1/replace-through-secret-manager"}}
RPC_REQUEST_TIMEOUT_MS=5000

# Per-chain confirmation depths are chain-specific registry configuration
# (set per chain via the admin API), never a single global env constant.

# Wallet network allowlist (registry chain id -> mainnet/testnet).
WALLET_NETWORK_ALLOWLIST={"ethereum-mainnet":"mainnet","ethereum-sepolia":"testnet"}

# Merchant webhook delivery (versioned platform signing keys).
WEBHOOK_HMAC_CURRENT_KEY_ID=v1
WEBHOOK_HMAC_CURRENT_SECRET=replace-through-secret-manager-32-bytes-minimum
WEBHOOK_HMAC_PREVIOUS_KEY_ID=
WEBHOOK_HMAC_PREVIOUS_SECRET=
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETENTION_SEC=604800

# Internal ingestion HMAC (versioned keys). The current pair signs watcher
# submissions; the previous pair stays valid during rotation only.
INGESTION_HMAC_CURRENT_KEY_ID=v1
INGESTION_HMAC_CURRENT_SECRET=replace-through-secret-manager-32-bytes-minimum
INGESTION_HMAC_PREVIOUS_KEY_ID=
INGESTION_HMAC_PREVIOUS_SECRET=
INGESTION_TIMESTAMP_SKEW_SEC=300
# Must cover at least twice the timestamp skew window.
INGESTION_NONCE_TTL_SEC=600
# Where the watcher submits captured on-chain events (the gateway api
# process). Keep this on the internal network; the endpoint requires HMAC
# plus network policy (private network / mTLS / VPC) in production.
INTERNAL_INGESTION_BASE_URL=http://api:3000

# Durable watcher.
WATCHER_POLL_INTERVAL_MS=2000
WATCHER_BATCH_SIZE=10
WATCHER_REGISTRY_REFRESH_SEC=30
# Anchor for the first sync cursor; 0 starts at the current head.
WATCHER_INITIAL_LOOKBACK_BLOCKS=0

# Payment processing. Late arrivals and reorg replacement windows extend
# this grace beyond expiry; overpayment tolerance records excess by default;
# confirmation jobs re-poll at this interval; reorg resolution walks at most
# this many blocks back to find a fork point.
OVERPAYMENT_ALLOW=true
LATE_PAYMENT_GRACE_SEC=900
CONFIRMATION_POLL_INTERVAL_MS=5000
REORG_MAX_SCAN_BLOCKS=200

# Payment lifecycle bounds and rate limits.
PAYMENT_EXPIRY_MIN_SEC=300
PAYMENT_EXPIRY_MAX_SEC=7200
PAYMENT_EXPIRY_DEFAULT_SEC=900
IDEMPOTENCY_TTL_SEC=86400
PAYMENT_CREATE_RATE_LIMIT_PER_MINUTE=30
ADMIN_RATE_LIMIT_PER_MINUTE=20

# Phase 10: HTTP hardening. Empty CORS list means no CORS headers are
# emitted (API-only surface); trust-proxy hops are required only behind a
# reverse proxy that overwrites X-Forwarded-*.
CORS_ALLOWED_ORIGINS=https://merchant.example,https://admin.example
TRUST_PROXY_HOPS=1
RATE_LIMIT_PUBLIC_PER_MINUTE=600
RATE_LIMIT_INGESTION_PER_MINUTE=12000

# Scheduler job cadence and lease coordination.
SCHEDULER_LEASE_TTL_SEC=60
SCHEDULER_EXPIRY_SWEEP_SEC=30
SCHEDULER_CONFIRMATION_RECHECK_SEC=60
SCHEDULER_STUCK_PAYMENT_SEC=300
SCHEDULER_SCREENING_RECHECK_SEC=300
SCHEDULER_REGISTRY_REFRESH_SEC=60
SCHEDULER_WEBHOOK_SWEEP_SEC=30
SCHEDULER_RETENTION_SEC=3600
STUCK_PAYMENT_THRESHOLD_SEC=1800

# Sanctions screening. The static list is the fail-closed fallback; replace
# with a managed screening provider before processing real funds.
SANCTIONS_PROVIDER=static-ofac
SANCTIONS_PROVIDER_API_KEY=replace-through-secret-manager
SANCTIONS_STATIC_LIST={"listVersion":"example-v1","addresses":[]}
SCREENING_CACHE_TTL_SEC=604800
# A managed (admin-ingested) sanctions list older than this fails closed —
# every screen returns unavailable and payments hold.
SCREENING_LIST_MAX_AGE_SEC=604800
